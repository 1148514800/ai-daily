# Copy this file to .env and fill in values as needed.
# Do not commit .env.

# development | test | production. Default: development.
# Only "production" demands --allow-production from the maintenance jobs, but the
# default database file is guarded whatever this says (see the README).
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Digest date timezone. The daily digest date is computed in this timezone.
APP_TIMEZONE=Asia/Shanghai

# Daily automatic refresh. Default: every day at 08:00 Asia/Shanghai.
# Set SCHEDULER_ENABLED=false to keep the API running without automatic refresh.
SCHEDULER_ENABLED=true
DAILY_REFRESH_HOUR=8
DAILY_REFRESH_MINUTE=0

# SQLite persistence. The path stays relative so it is machine independent.
# The file lives at backend/data/ai_daily.db
#
# This is also the production database. Maintenance jobs that write
# (rebuild_search_index, rebuild_digests, backfill_article_content) refuse to run
# against it unless --allow-production is passed, and back it up first. Point
# DATABASE_URL at a scratch file while experimenting:
#
#   DATABASE_URL=sqlite:///./data/scratch.db uv run python -m app.jobs.rebuild_search_index
#
# An unfamiliar PostgreSQL URL is supported by SQLAlchemy but is not backed up
# automatically; only SQLite is copied before a production write.
DATABASE_URL=sqlite:///./data/ai_daily.db

# Development-only CORS currently allows all origins.
# Do not use wildcard origins in production.
# CORS_ALLOW_ORIGINS=http://localhost:8081

# LLM enrichment. RSS remains the source of truth.
# If LLM_ENABLED=false or LLM_API_KEY is empty, the API still works with original RSS text.
# The digest then falls back to English source text, which is expected and valid.
LLM_ENABLED=false
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
# Optional: override cache directory. Default is backend/.cache/llm
# LLM_CACHE_DIR=.cache/llm
# How much of the article body is sent to the LLM. Default: 6000 characters.
# LLM_CONTENT_MAX_CHARS=6000

# Baidu AI Search / Web Discovery probe.
# Do not commit a real key.
BAIDU_SEARCH_API_KEY=

# Aliyun CleverSee (IQS) Web Search probe.
# Do not commit a real key.
ALIYUN_SEARCH_API_KEY=

# Tavily Search. Read by the Web Discovery layer during a refresh, and by the
# benchmark probe. Do not commit a real key.
TAVILY_API_KEY=

# Optional. Improves GitHub API rate limits for public repo metadata.
# Without a token the anonymous limit is 60 requests/hour; the GitHub page then
# falls back to strict keyword filtering.
# Never commit the real token or send it to the mobile app.
GITHUB_TOKEN=

# Optional. Where maintenance jobs put their automatic pre-write backups.
# Default: backups/ at the repository root.
# AI_DAILY_BACKUP_DIR=../backups

# System push notifications are NOT part of the current product.
# The daily notification feature was opted out of, so it stays off and dormant.
# Leave this false; the code path is kept only so the feature can be restored later.
PUSH_ENABLED=false
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# --- Web Discovery (Tavily) ------------------------------------------------
# A supplementary discovery layer beside the fixed sources. It is OFF by default,
# so with these values unchanged AI Daily behaves exactly as it did before the
# layer existed: no request is made and no API key is needed.
#
# When enabled, Tavily is asked the same fixed topic queries every refresh and
# whatever it finds is treated as candidates: they still pass the same window
# filter, article extraction, LLM importance, media selection and ranking as a
# fixed source. Discovery adds recall; it does not decide what the digest says.
#
# An enabled layer with no key is reported once and skipped, never a refresh
# failure: the fixed sources carry the digest on their own either way.
WEB_DISCOVERY_ENABLED=false
WEB_DISCOVERY_PROVIDER=tavily

# The key is TAVILY_API_KEY, declared with the probes above; the refresh reads the
# same variable. Budget it for roughly 10 credits per refresh (10 queries x 1
# credit at basic depth).

# 1-20 results per query, which is the provider maximum. 10 matches the benchmark.
WEB_DISCOVERY_RESULTS_PER_QUERY=10
# The cap on candidates allowed into article extraction and the LLM.
WEB_DISCOVERY_MAX_CANDIDATES=24
# How many candidates one hostname may contribute, so no single portal fills the
# allowance. A soft per-run pre-selection, not a blacklist.
WEB_DISCOVERY_MAX_PER_DOMAIN=2
# Seconds to wait for one query.
WEB_DISCOVERY_TIMEOUT=15

# Per-candidate KEEP/DROP logging for the discovery funnel. Off by default.
# AI_DAILY_DEBUG_WEB_DISCOVERY=1
