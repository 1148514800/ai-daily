# Copy to .env if you need a non-default API origin.
# Do not commit a machine-specific LAN IP.

# Local Expo web / iOS simulator
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Android emulator (AVD)
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000

# Physical phone on the same Wi-Fi
# EXPO_PUBLIC_API_BASE_URL=http://192.168.x.x:8000

# EAS project id, required for Expo Push Tokens.
# `npx eas init` writes it into app.json extra.eas.projectId; the env var keeps
# local development working before EAS is configured.
# EXPO_PUBLIC_EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000
