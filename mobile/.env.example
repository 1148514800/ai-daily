# Copy to .env if you need a different default backend origin.
# Do not commit a machine-specific LAN IP.

# Local Expo web / iOS simulator
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Android emulator (AVD)
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000

# Physical phone on the same Wi-Fi.
# Prefer the in-app 设置 -> Backend 地址 field instead of baking an IP into the
# APK: a saved address survives a changed LAN IP without a rebuild.
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:8000
